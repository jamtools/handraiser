{
    "compilerOptions": {
        "verbatimModuleSyntax": true,
        "jsx": "react",
        "skipLibCheck": true,
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "module": "es2020",
        "target": "es2016",
        "moduleResolution": "bundler",
        "baseUrl": ".",
    },
}
